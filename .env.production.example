APP_NAME="CRM Cotizaciones Concreplus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.concreplus.com.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=PENDIENTE
DB_PORT=3306
DB_DATABASE=PENDIENTE
DB_USERNAME=PENDIENTE
DB_PASSWORD=PENDIENTE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=crm.concreplus.com.mx
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_SHEETS_SPREADSHEET_ID=PENDIENTE
GOOGLE_SHEETS_CREDENTIALS_PATH=storage/app/google/credentials.json
GOOGLE_SHEETS_TABS="Cotizaciones"

CRM_OPERATIONAL_START_DATE=2026-09-28
CRM_DEFAULT_VENDEDORA_EMAIL=IGonzalez@concreplus.com.mx

HEALTHCHECKS_SHEETS_IMPORT_URL=PENDIENTE

REMINDER_FIRST_MINUTES=5
REMINDER_SECOND_MINUTES=15
REMINDER_NOTIFY_COORDINATOR_MINUTES=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=PENDIENTE
MAIL_PORT=PENDIENTE
MAIL_USERNAME=PENDIENTE
MAIL_PASSWORD=PENDIENTE
MAIL_FROM_ADDRESS=PENDIENTE
MAIL_FROM_NAME="${APP_NAME}"

COMMERCIAL_WEEKLY_REPORT_EMAILS=
